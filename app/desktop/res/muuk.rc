// Muuk's Windows resources: the app icon (GLFW_ICON is also the window's
// title-bar icon -- GLFW picks it by that name) and the version info that
// Explorer and Task Manager show ("Muuk" instead of muuk-desktop.exe).
#include <winver.h>
#include "../src/version.hpp"

GLFW_ICON ICON "muuk.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MUUK_VERSION_COMMAS
 PRODUCTVERSION MUUK_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Muuk"
            VALUE "FileDescription", "Muuk"
            VALUE "FileVersion", MUUK_VERSION_STR
            VALUE "InternalName", "muuk-desktop"
            VALUE "OriginalFilename", "muuk-desktop.exe"
            VALUE "ProductName", "Muuk"
            VALUE "ProductVersion", MUUK_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
